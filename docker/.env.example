TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890
THE_ODDS_API_KEY=your_odds_api_key_here
GUARDIAN_API_KEY=your_guardian_api_key_here
API_FOOTBALL_KEY=your_api_football_key_here
# OLLAMA_HOST defaults to http://ollama:11434 (the ollama service on the compose network)
# ADVANCE_MINUTES defaults to 60
# CHECKPOINT_PATH defaults to checkpoints/neural_v2.pt — the stable name the trainer
# service promotes into after every retrain; scheduler always reads this same path.
